# Copy this file to .env and fill it in. .env is private and never committed.

# --- The portal ---
PORTAL_NAME="AI Reel Studio"
PORTAL_ACCENT=#2dd4bf
PORT=4400
# 127.0.0.1 = only this Mac can open it. Leave as is until you go live.
HOST=127.0.0.1
# The address clients use. Used in emails and the login message.
SITE_URL=http://localhost:4400

# --- Production (when the portal is public) ---
# NODE_ENV=production makes the portal refuse to start with a weak ADMIN_PASSWORD or a non-https SITE_URL,
# listens on all interfaces, and caches static files.
# NODE_ENV=production
# Number of proxies in front of the portal: 1 on Railway / Render / Fly, leave unset behind Cloudflare Tunnel.
# TRUST_PROXY=1
# Time zone for emails and brief.md (pages always show the viewer's own time).
# TZ=Asia/Kolkata

# --- Your admin login (the only admin) ---
# Change ADMIN_PASSWORD here and restart the portal to reset it.
ADMIN_NAME="Studio"
ADMIN_EMAIL=you@example.com
# At least 12 characters. The portal won't start in production with a placeholder.
ADMIN_PASSWORD=change-me-to-something-long

# --- Where files go (defaults to the folder above portal/) ---
# STUDIO_ROOT=/Users/you/Documents/AI Reel Studio

# --- Timing ---
DEFAULT_ETA_MINUTES=60

# --- Email ---
# Gmail: Google Account > Security > 2-Step Verification > App passwords. Paste the 16 letters (spaces are fine).
# GMAIL_USER=you@gmail.com
# GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
# Where your own alerts go (new video, changes requested, approved). Defaults to GMAIL_USER.
# ALERT_EMAIL=you@gmail.com
# Optional: a different sender line, e.g. "Priya at Reel Studio <you@gmail.com>"
# MAIL_FROM=
# Or any other SMTP server instead of Gmail:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASS=
# Without any of these, emails are saved to data/outbox/ and listed in Admin > Emails.

# --- Timing ---
# EXPORT_ETA_MINUTES=15

# --- Google Drive ---
# When a client sends a video, ask Google (anonymously) whether their Drive link opens, and refuse
# links that aren't shared yet. Set to off to skip the check.
# DRIVE_LINK_CHECK=on

# --- Housekeeping ---
# Chunk size in MB (4-64) for the style reels you upload.
# UPLOAD_CHUNK_MB=16
# Client drafts (uploads never sent with Continue) untouched this many days are removed. 0 = keep forever.
# DRAFT_RETENTION_DAYS=30
# How many daily database backups to keep in data/backups/.
# BACKUP_KEEP=14
