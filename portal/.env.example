# Copy this file to .env and fill it in. .env is private and never committed.

# --- The portal ---
PORTAL_NAME="AI Reel Studio"
PORTAL_ACCENT=#2dd4bf
PORT=4400
# 127.0.0.1 = only this Mac can open it. Leave as is until you go live.
HOST=127.0.0.1
# The address clients use. Used in emails and the login message.
SITE_URL=http://localhost:4400

# --- Your admin login (the only admin) ---
# Change ADMIN_PASSWORD here and restart the portal to reset it.
ADMIN_NAME="Studio"
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-to-something-long

# --- Where files go (defaults to the folder above portal/) ---
# STUDIO_ROOT=/Users/you/Documents/AI Reel Studio

# --- Timing ---
DEFAULT_ETA_MINUTES=60

# --- Email ---
# Gmail: Google Account > Security > 2-Step Verification > App passwords. Paste the 16 letters (spaces are fine).
# GMAIL_USER=you@gmail.com
# GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
# Where your own alerts go (new video, changes requested, approved). Defaults to GMAIL_USER.
# ALERT_EMAIL=you@gmail.com
# Optional: a different sender line, e.g. "Priya at Reel Studio <you@gmail.com>"
# MAIL_FROM=
# Or any other SMTP server instead of Gmail:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASS=
# Without any of these, emails are saved to data/outbox/ and listed in Admin > Emails.

# --- Timing ---
# EXPORT_ETA_MINUTES=15
