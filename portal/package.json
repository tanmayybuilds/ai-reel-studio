{
  "name": "reel-studio-portal",
  "version": "0.1.0",
  "private": true,
  "description": "Client and admin portal for AI Reel Studio: clients send footage, the studio edits, clients review and download.",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "demo": "node --env-file-if-exists=.env scripts/seed-demo.js",
    "test": "node --test tests/*.test.js && node scripts/e2e.js",
    "backup": "node --env-file-if-exists=.env scripts/backup.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "express": "5.3.0",
    "nodemailer": "10.3.1",
    "web-push": "3.6.7"
  }
}
